#!/usr/bin/env bash
set -e

# Post-bootstrap configuration script for Calamares
# Reads DISTRO from environment to determine distro-specific setup

DISTRO="${DISTRO:-arch}"

case "$DISTRO" in
  arch)
    # Update HoldPkg in pacman.conf
    packages=$(pacman -Qetq | tr '\n' ' ')
    sed -i "s|^HoldPkg.*$|HoldPkg      = ash-git $packages|g" /etc/pacman.conf

    # Add boot backup directory
    mkdir -p /boot/grub/BAK

    # Create AUR User
    useradd -m -s /bin/bash aur
    echo 'aur ALL=(ALL:ALL) NOPASSWD: ALL' | tee /etc/sudoers.d/aur
    chmod 0440 /etc/sudoers.d/aur

    # Ash configurations
    chmod 700 /.snapshots/ash/root
    chmod 1777 /.snapshots/ash/tmp
    mkdir -p /usr/share/ash
    chmod 755 /usr/share/ash
    echo '0' > /usr/share/ash/snap
    mkdir -p /etc/ash
    chmod 755 /etc/ash

    cat > /etc/ash/ash.conf << EOF
mutable_dirs::
mutable_dirs_shared::var
aur::False
EOF
    chmod 644 /etc/ash/ash.conf

    echo '0' > /.snapshots/ash/upstate
    date >> /.snapshots/ash/upstate
    echo "{'name': 'root', 'children': [{'name': '0'}]}" > /.snapshots/ash/fstree

    touch /etc/ash/profile
    chmod 644 /etc/ash/profile
    packages_lines=$(echo "$packages" | tr ' ' '\n')
    cat > /etc/ash/profile << EOF
[system-packages]
$packages_lines
[profile-packages]
[enable-services]
[disable-services]
[install-commands]
EOF

    mkdir -p /.snapshots/ash/snapshots
    echo '' > /.snapshots/ash/deploy-tmp
    ln -sf /.snapshots/ash /var/lib/ash

    # Install ash
    su aur -c 'paru -Sy ash-git --noconfirm'
    ;;

  debian)
    # Debian post-bootstrap setup
    # Configure locale
    echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
    locale-gen

    # Set timezone
    ln -sf /usr/share/zoneinfo/UTC /etc/localtime

    # Configure hostname
    echo "calamares" > /etc/hostname

    # Enable services
    systemctl enable NetworkManager.service 2>/dev/null || true
    ;;

  fedora)
    # Fedora post-bootstrap setup
    # Configure locale
    localedef -c -f UTF-8 -i en_US en_US.UTF-8 2>/dev/null || true

    # Set timezone
    ln -sf /usr/share/zoneinfo/UTC /etc/localtime

    # Configure hostname
    echo "calamares" > /etc/hostname

    # Enable services
    systemctl enable NetworkManager.service 2>/dev/null || true
    ;;

  *)
    echo "WARNING: Unknown distro '$DISTRO', skipping post-bootstrap setup"
    ;;
esac
